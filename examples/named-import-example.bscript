// Named Import Example
// Demonstrates importing code with a name and calling it multiple times

// Import specific operations with names
import andOp from './libs/bitwise-ops.bscript'
import orOp from './libs/bitwise-ops.bscript'

// Now we can use these names like function calls
// Each time the name appears, the imported code is inlined

// Call andOp - this inlines "12 10 and"
andOp
// Stack: [0x08]

verify
// Stack: []

// Call orOp - this inlines "12 10 or"
orOp
// Stack: [0x0e]

verify

// We can call them multiple times
andOp
// Stack: [0x08]

// No verify here: it would empty the stack, and a script must end with a
// true value on it

// The imported code is executed inline each time the name is used

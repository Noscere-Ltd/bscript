// Simple Named Import Example
// Import an entire file and give it a name

import bitwise from './libs/simple-bitwise.bscript'

// Now "bitwise" can be used multiple times
// Each occurrence inlines "12 10 and"

bitwise
// Stack: [0x08]

verify
// Stack: []

bitwise
// Stack: [0x08]

verify

bitwise
// Stack: [0x08]

// No verify here: it would empty the stack, and a script must end with a
// true value on it

// This demonstrates that the imported code executes inline
// each time the name is referenced
